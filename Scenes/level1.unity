--- !u!114 &397184661
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 397184660}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d6e62d09d4b8974408cafe59aa15f6a2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  player: {fileID: 395647805}
  dialogue: {fileID: 1500205671}
  parameters:
  - line: Hmpf...
    image: {fileID: 21300000, guid: c99bbe7de29507c468f569b21dec89e2, type: 3}
    speed: 0.1
    showsInSameBox: 0
    endsAutomatically: 1
    waitTime: 0
    stop: 0
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - line: Where am I?
    image: {fileID: 21300000, guid: c99bbe7de29507c468f569b21dec89e2, type: 3}
    speed: 0.03
    showsInSameBox: 1
    endsAutomatically: 0
    waitTime: 0
    stop: 0
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - line: This is an automated message. You have been selected to participate in
      the contest to become the mighty Nekromage's new Mayd.
    image: {fileID: 21300000, guid: 047ca072feba97649a8e9dfb89d2540a, type: 3}
    speed: 0.03
    showsInSameBox: 0
    endsAutomatically: 0
    waitTime: 0
    stop: 0
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - line: Wait, I don't think that is the correct spelling...
    image: {fileID: 21300000, guid: c99bbe7de29507c468f569b21dec89e2, type: 3}
    speed: 0.03
    showsInSameBox: 0
    endsAutomatically: 0
    waitTime: 0
    stop: 0
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - line: And before you say something dumb like "That is not the correct spelling",
      I will inform you that Mayd is an acronym.
    image: {fileID: 21300000, guid: 047ca072feba97649a8e9dfb89d2540a, type: 3}
    speed: 0.03
    showsInSameBox: 0
    endsAutomatically: 0
    waitTime: 0
    stop: 0
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - line: It stands for "Maid at your disposal"
    image: {fileID: 21300000, guid: 047ca072feba97649a8e9dfb89d2540a, type: 3}
    speed: 0.03
    showsInSameBox: 0
    endsAutomatically: 0
    waitTime: 0
    stop: 0
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - line: A bit redundant... But how did I end up here?
    image: {fileID: 21300000, guid: c99bbe7de29507c468f569b21dec89e2, type: 3}
    speed: 0.03
    showsInSameBox: 0
    endsAutomatically: 0
    waitTime: 0
    stop: 0
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - line: Kidnap.
    image: {fileID: 21300000, guid: 047ca072feba97649a8e9dfb89d2540a, type: 3}
    speed: 0.1
    showsInSameBox: 0
    endsAutomatically: 0
    waitTime: 0
    stop: 0
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - line: Wait, you said that this message was automated...
    image: {fileID: 21300000, guid: c99bbe7de29507c468f569b21dec89e2, type: 3}
    speed: 0.03
    showsInSameBox: 0
    endsAutomatically: 0
    waitTime: 0
    stop: 0
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - line: Ehmm. Argh... Damn you. Fine, go take a stroll or something... I need to
      calm down.
    image: {fileID: 21300000, guid: 047ca072feba97649a8e9dfb89d2540a, type: 3}
    speed: 0.03
    showsInSameBox: 0
    endsAutomatically: 0
    waitTime: 0
    stop: 0
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - line: Are you alright?
    image: {fileID: 21300000, guid: c99bbe7de29507c468f569b21dec89e2, type: 3}
    speed: 0.03
    showsInSameBox: 0
    endsAutomatically: 0
    waitTime: 0
    stop: 0
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  - line: NO! I. AM. NOT. Listen, jut go, ok?
    image: {fileID: 21300000, guid: 047ca072feba97649a8e9dfb89d2540a, type: 3}
    speed: 0.01
    showsInSameBox: 0
    endsAutomatically: 0
    waitTime: 0
    stop: 0
    onLineReached:
      m_PersistentCalls:
        m_Calls: []
  interruptPlayer: 1
  isActive: 1
